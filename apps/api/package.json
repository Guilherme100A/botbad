  },
  "dependencies": {
    "@botbad/contracts": "*",
    "@botbad/db": "*",
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "^0.35.0",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
