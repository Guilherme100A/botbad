# Copy to .env and fill in. Never commit .env.

# ── Required in production ──
NODE_ENV=production
# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Origin(s) of the panel, comma-separated (same as the public site when served by Caddy)
CORS_ORIGINS=https://router.example.com
# Public URL of this router; destinations pointing back at /r/* on it are rejected as loops
PUBLIC_BASE_URL=https://router.example.com

# ── Database ──
# docker compose builds DATABASE_URL from this password; outside Docker set DATABASE_URL directly
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/botbad

# ── Jev engine ──
# real (TypeSafe API, needs JEV_API_KEY) | openrouter (evaluation stand-in, needs OPENROUTER_API_KEY) | mock (dev only)
JEV_ADAPTER=real
JEV_API_KEY=
OPENROUTER_API_KEY=
# Call deadline in ms. Spec: 600 for the real API. The OpenRouter stand-in is an LLM and needs ~15000.
# JEV_TIMEOUT_MS=600

# Confidence thresholds (placeholders until calibrated on a labeled set)
# JEV_MIN_CONFIDENCE_PRIMARY=0.75
# JEV_MIN_CONFIDENCE_AUTOMATION=0.6
# JEV_MAX_AUTOMATION_FOR_PRIMARY=0.3

# ── Limits ──
# RATE_LIMIT_PER_IP_PER_MIN=120

# ── Proxy ──
# Peers allowed to set X-Forwarded-For (IPs or CIDRs). docker compose sets this to the Caddy container.
# TRUSTED_PROXIES=

# ── Docker / first run ──
# Domain Caddy serves (and gets TLS for). "localhost" to try locally.
SITE_ADDRESS=router.example.com
# First owner account, created by `node dist/seed.js` / `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# JWT lifetime in seconds (default 8h)
# JWT_TTL_SECONDS=28800
