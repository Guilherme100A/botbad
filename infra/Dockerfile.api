# API image: the build bundles the server and its dependencies into dist/,
# so the runtime stage needs no node_modules.
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/db/package.json packages/db/
RUN npm ci
COPY . .
RUN npm run build -w @botbad/api

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/apps/api/dist ./dist
USER node
EXPOSE 3000
# Same image runs migrations/seed: `node dist/migrate.js`, `node dist/seed.js`.
CMD ["node", "dist/server.js"]
